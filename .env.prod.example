# Copy to .env.prod and fill values. Never commit .env.prod.

# Public host (IP, sslip.io, or domain) — used by Caddy + URLs
CODEVOX_HOST=
NEXTAUTH_URL=http://localhost
NEXTAUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost
NEXT_PUBLIC_RECRUITMENT_API_URL=http://localhost
PUBLIC_API_BASE_URL=http://localhost
LIVEKIT_PUBLIC_URL=ws://localhost:7885

# Auth (landing Sign in auto-logs with these)
LOCAL_AUTH_TOKEN=
LOCAL_AUTH_EMAIL=akshat@CodeVox
LOCAL_AUTH_PASSWORD=admin
LOCAL_AUTH_NAME=Akshat

# MySQL
MYSQL_ROOT_PASSWORD=
RECRUITMENT_MYSQL_DATABASE=codevox
RECRUITMENT_MYSQL_USER=codevox
RECRUITMENT_MYSQL_PASSWORD=

# LiveKit
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devlocal_livekit_secret_minimum_32b

# Voice / AI (free-tier keys OK for demo)
VOICE_ENGINE_URL=http://voice_engine:8001
AUTONOMOUS_INTERVIEW_SERVICE_KEY=
SARVAM_API_KEY=
OPENAI_API_KEY=
TAKEHOME_LLM_KEY=
TAKEHOME_LLM_PROVIDER=
TAKEHOME_LLM_MODEL=

# Keep recordings off on free VPS disk
RECORDING_MODE=off
LIVEKIT_EGRESS_ENABLED=false
BUILD_VIDEO_RECORDING_ENABLED=false
NEXT_PUBLIC_FACE=off
