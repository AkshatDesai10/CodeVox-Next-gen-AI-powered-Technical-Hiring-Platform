# CodeVox backend env example

# --- Email / SMTP (use your own mailbox; leave blank to disable sending) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_REPLY_TO=

# Optional recording path (defaults to uploads/interview-recordings)
# RECORDING_S3_PREFIX=

# --- System Configurations dashboard (DB overrides these; empty DB = env fallback) ---
FACE=
PROCTOR_ENABLE_MEDIA_STRIKES=
PROCTOR_ENABLE_FOCUS_STRIKES=
PROCTOR_MAX_MEDIA_STRIKES=
PROCTOR_AUTO_SUBMIT_ON_MEDIA_STRIKE=
PROCTOR_MAX_FOCUS_STRIKES=
PROCTOR_AUTO_SUBMIT_ON_FOCUS_STRIKE=
PROCTOR_FOCUS_STRIKE_THRESHOLD_SECONDS=
PROCTOR_GRACE_SECONDS=
TAKEHOME_LLM_PROVIDER=
TAKEHOME_LLM_MODEL=
TAKEHOME_LLM_REASONING_EFFORT=
TAKEHOME_LLM_MAX_TOKENS=
TAKEHOME_LLM_KEY=
SARVAM_TTS_SPEAKER=
SARVAM_TTS_PACE=
SARVAM_API_KEY=
RECORDING_MODE=
OPENAI_API_KEY=
DEEPFLAG_API_KEY=
