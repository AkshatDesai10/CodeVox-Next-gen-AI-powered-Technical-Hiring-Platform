# CodeVox frontend — local credentials auth
NEXTAUTH_URL=
NEXTAUTH_SECRET=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_RECRUITMENT_API_URL=

# Must match backend LOCAL_AUTH_TOKEN
LOCAL_AUTH_TOKEN=
LOCAL_AUTH_EMAIL=
LOCAL_AUTH_PASSWORD=
LOCAL_AUTH_NAME=

# Face capture at candidate portal. Keep in sync with backend FACE.
# on|true|1|yes vs off|false|0|no. Restart `npm run dev` after change.
NEXT_PUBLIC_FACE=

# Proctoring media strikes. Restart `npm run dev` after changing these.
# false: count and log strikes, but never end the interview.
NEXT_PUBLIC_PROCTOR_AUTO_SUBMIT_ON_STRIKE=
# Strict mode ends the interview on this strike. Warnings run through max - 1.
NEXT_PUBLIC_PROCTOR_MAX_STRIKES=
NEXT_PUBLIC_PROCTOR_GRACE_SECONDS=

# --- Copied from Recruitment (system configurations) ---
NEXT_PUBLIC_PROCTOR_ENABLE_MEDIA_STRIKES=
NEXT_PUBLIC_PROCTOR_ENABLE_FOCUS_STRIKES=
NEXT_PUBLIC_PROCTOR_MAX_MEDIA_STRIKES=
NEXT_PUBLIC_PROCTOR_AUTO_SUBMIT_ON_MEDIA_STRIKE=
NEXT_PUBLIC_PROCTOR_MAX_FOCUS_STRIKES=
NEXT_PUBLIC_PROCTOR_AUTO_SUBMIT_ON_FOCUS_STRIKE=
NEXT_PUBLIC_PROCTOR_FOCUS_STRIKE_THRESHOLD_SECONDS=
