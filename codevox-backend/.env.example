# CodeVox backend env example

# --- Email / SMTP (use your own mailbox; leave blank to disable sending) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_REPLY_TO=

# Optional recording path (defaults to uploads/interview-recordings)
# RECORDING_S3_PREFIX=uploads/interview-recordings

# --- System Configurations dashboard (DB overrides these; empty DB = env fallback) ---
FACE=on
PROCTOR_ENABLE_MEDIA_STRIKES=false
PROCTOR_ENABLE_FOCUS_STRIKES=false
PROCTOR_MAX_MEDIA_STRIKES=5
PROCTOR_AUTO_SUBMIT_ON_MEDIA_STRIKE=false
PROCTOR_MAX_FOCUS_STRIKES=5
PROCTOR_AUTO_SUBMIT_ON_FOCUS_STRIKE=false
PROCTOR_FOCUS_STRIKE_THRESHOLD_SECONDS=5
PROCTOR_GRACE_SECONDS=90
TAKEHOME_LLM_PROVIDER=gemini
TAKEHOME_LLM_MODEL=gemini-3.6-flash
TAKEHOME_LLM_REASONING_EFFORT=low
TAKEHOME_LLM_MAX_TOKENS=16384
TAKEHOME_LLM_KEY=
SARVAM_TTS_SPEAKER=meera
SARVAM_TTS_PACE=0.90
SARVAM_API_KEY=
RECORDING_MODE=track
OPENAI_API_KEY=
DEEPFLAG_API_KEY=
