# CodeVox frontend — local credentials auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_RECRUITMENT_API_URL=http://localhost:4000

# Must match backend LOCAL_AUTH_TOKEN (default local-dev-token)
LOCAL_AUTH_TOKEN=local-dev-token
LOCAL_AUTH_EMAIL=admin@localhost
LOCAL_AUTH_PASSWORD=admin
LOCAL_AUTH_NAME=Local Admin

# Face capture at candidate portal. Keep in sync with backend FACE.
# on|true|1|yes (default) vs off|false|0|no. Restart `npm run dev` after change.
NEXT_PUBLIC_FACE=on

# Proctoring media strikes. Restart `npm run dev` after changing these.
# false: count and log strikes, but never end the interview.
NEXT_PUBLIC_PROCTOR_AUTO_SUBMIT_ON_STRIKE=false
# Strict mode ends the interview on this strike. Warnings run through max - 1.
NEXT_PUBLIC_PROCTOR_MAX_STRIKES=5
NEXT_PUBLIC_PROCTOR_GRACE_SECONDS=90
